root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cpp,h,hpp}]
indent_size = 2

[*.py]
indent_size = 4

[*.{yaml,yml,xml,urdf,sdf,rviz,srv}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[*.md]
indent_size = 2
